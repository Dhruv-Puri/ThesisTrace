# Copy to .env and fill in what you need. EVERYTHING here is optional —
# Paper2Reality runs fully local/offline without any of it.

# Google Gemini free-tier API key (https://aistudio.google.com/apikey)
# Leave empty -> template-based report, heuristic claims; app still works end-to-end.
GEMINI_API_KEY=

# Hardware toggles for weak machines
LOW_RAM=0          # 1 = flan-t5-small + gazetteer-only NER + distilbert MNLI
SEMANTIC=0         # 1 = add all-MiniLM-L6-v2 semantic rerank (+~300 MB RAM)

# Hugging Face cache (set automatically by docker-compose to the hf_cache volume)
# HF_HOME=/models/hf
