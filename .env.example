# Copy to .env and fill in what you need. EVERYTHING here is optional -
# ThesisTrace runs fully local/offline without any of it.

# Google Gemini free-tier API key (https://aistudio.google.com/apikey)
# Leave empty -> heuristic claims + template report; the app still works end-to-end.
# The Ask (chat) tab is the one feature that REQUIRES this key; without it the tab says so.
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=8
# GEMINI_CHAT_TIMEOUT=30   # the Ask tab's chat answers get a longer timeout

# Hardware toggles for weak machines.
# LOW_RAM=1 uses flan-t5-small + gazetteer-only NER + distilbert MNLI.
LOW_RAM=0
# Semantic rerank is future work in this MVP; TF-IDF retrieval is always used.
SEMANTIC=0

# Where uploaded PDFs/jobs live. Inside Docker this is a named volume.
# Leave unset for a project-local .data directory (deleting the folder removes it).
# THESISTRACE_DATA_DIR=/data

# Feature toggles
# P2R_TOKENIZER_STUDY=1
# P2R_LLM_CLAIMS=1
# P2R_LLM_REPORT=0
# Feature toggles (the old P2R_* names still work as a fallback)
# THESISTRACE_TOKENIZER_STUDY=1
# THESISTRACE_LLM_CLAIMS=1
# THESISTRACE_LLM_REPORT=0

# Job queue + retention (public-deployment knobs; defaults suit a laptop)
# THESISTRACE_JOB_MODE=inline            # inline = API runs workers; external = run `python -m api.jobs.worker`
# THESISTRACE_JOB_WORKERS=1              # >1 shares loaded models across threads: needs RAM
# THESISTRACE_JOB_MAX_QUEUE=20           # queued + running; above this uploads get HTTP 503
# THESISTRACE_JOB_TIMEOUT_SECONDS=900    # a job running longer is stopped
# THESISTRACE_UPLOAD_TTL_SECONDS=3600    # uploaded file deleted this long after the job finishes
# THESISTRACE_RESULT_TTL_SECONDS=86400   # whole analysis deleted after this
