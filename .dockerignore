# Keep images small and host state out of builds
.git
.gitignore
# Secrets never enter the image; passed at runtime instead.
.env
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
# Never bake uploads or runtime state into an image.
.data
# Docs are not needed inside containers.
documentation
eval/results
client/node_modules
client/dist
# Tests are run from the repo, not shipped in the image.
api/tests
*.md
!requirements.txt
